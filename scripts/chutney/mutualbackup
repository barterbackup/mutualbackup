# Keep enough non-authority relays for diverse three-hop onion circuits. The
# acceptance harness lowers Arti's filtered guard-sample minimum because its
# production default would consume almost this entire deliberately small test
# network. MutualBackup starts its five clients and services in sequence, so no
# Chutney-managed client or onion service is needed.
ConfigureNodes(
    Node(tag="a", authority=1, relay=1).getN(4)
    + Node(tag="r", relay=1, exit=1).getN(20)
)

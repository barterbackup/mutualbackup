; MutualBackup local Unix-socket JSON data model.
; Frames are a 4-byte big-endian length followed by UTF-8 JSON.

local-request-envelope = {
  format_version: 2,
  request_id: bytes16-array,
  request: local-request
}

local-response-envelope = {
  format_version: 2,
  request_id: bytes16-array,
  result: { "Ok": local-response } / { "Err": wire-error }
}

local-request =
    "Status"
  / "StorageStatus"
  / "StorageScrub"
  / { "StorageReclaim": { volume_id: null / uuid-text } }
  / { "StorageDrain": { volume_id: uuid-text } }
  / "StorageMigrate"
  / { "StorageReactivate": { volume_id: uuid-text } }
  / "StorageReconcile"
  / { "GuildAudit": { repair: bool } }
  / { "Unlock": { secret: bytes32-array } }
  / { "AddRoot": { path: tstr } }
  / { "GitInit": { path: tstr } }
  / { "GitWorktreeAdd": { repository_id: uuid-text, path: tstr, branch: tstr } }
  / { "GitWorktrees": { repository_id: uuid-text } }
  / { "GitWorktreeResume": { repository_id: uuid-text, worktree_id: uuid-text } }
  / { "GitWorktreeStatus": { repository_id: uuid-text, worktree_id: uuid-text } }
  / { "GitWorktreeAddPath": { repository_id: uuid-text, worktree_id: uuid-text, path: tstr } }
  / { "GitWorktreeRemoveCached": { repository_id: uuid-text, worktree_id: uuid-text, path: tstr } }
  / { "GitWorktreeAbandonPendingAdd": { repository_id: uuid-text, worktree_id: uuid-text, path: tstr } }
  / { "GitWorktreeCommit": { repository_id: uuid-text, worktree_id: uuid-text, author_name: tstr, author_email: tstr, message: tstr } }
  / { "GitWorktreeLog": { repository_id: uuid-text, worktree_id: uuid-text, limit: uint } }
  / { "GitWorktreeBranches": { repository_id: uuid-text, worktree_id: uuid-text } }
  / { "GitWorktreeResetIndex": { repository_id: uuid-text, worktree_id: uuid-text, paths: [* tstr] } }
  / { "GitWorktreeCreateBranch": { repository_id: uuid-text, worktree_id: uuid-text, name: tstr } }
  / { "GitWorktreeCreateBranchFrom": { repository_id: uuid-text, worktree_id: uuid-text, name: tstr, start_point: tstr } }
  / { "GitWorktreeDeleteBranch": { repository_id: uuid-text, worktree_id: uuid-text, name: tstr, force: bool } }
  / { "GitWorktreeDiff": { repository_id: uuid-text, worktree_id: uuid-text, cached: bool } }
  / { "GitWorktreeSwitchBranch": { repository_id: uuid-text, worktree_id: uuid-text, name: tstr } }
  / { "GitAdd": { repository_id: uuid-text, path: tstr } }
  / { "GitRemoveCached": { repository_id: uuid-text, path: tstr } }
  / { "GitAbandonPendingAdd": { repository_id: uuid-text, path: tstr } }
  / { "GitCommit": { repository_id: uuid-text, author_name: tstr, author_email: tstr, message: tstr } }
  / { "GitLog": { repository_id: uuid-text, limit: uint } }
  / { "GitBranches": { repository_id: uuid-text } }
  / { "GitExportToGitRepository": { repository_id: uuid-text, source_root: tstr, destination: tstr, advertised: [* git-branch-info] } }
  / { "GitRemoteBranches": { repository_id: uuid-text } }
  / { "GitCommitPins": { repository_id: uuid-text } }
  / { "GitPinCommit": { repository_id: uuid-text, oid: bytes20-array } }
  / { "GitUnpinCommit": { repository_id: uuid-text, oid: bytes20-array } }
  / { "GitPrune": { repository_id: uuid-text } }
  / { "GitResetIndex": { repository_id: uuid-text, paths: [* tstr] } }
  / { "GitCreateBranch": { repository_id: uuid-text, name: tstr } }
  / { "GitCreateBranchFrom": { repository_id: uuid-text, name: tstr, start_point: tstr } }
  / { "GitDeleteBranch": { repository_id: uuid-text, name: tstr, force: bool } }
  / { "GitSwitchBranch": { repository_id: uuid-text, name: tstr } }
  / { "GitPushBare": { repository_id: uuid-text, path: tstr } }
  / { "GitFetchBare": { repository_id: uuid-text, path: tstr } }
  / { "GitPullBare": { repository_id: uuid-text, path: tstr, ? author_name: tstr, ? author_email: tstr } }
  / { "GitMergeBranch": { repository_id: uuid-text, branch: tstr, ? author_name: tstr, ? author_email: tstr } }
  / { "GitMergeContinue": { repository_id: uuid-text } }
  / { "GitMergeAbort": { repository_id: uuid-text } }
  / { "GitDiff": { repository_id: uuid-text, cached: bool } }
  / { "GitStatus": { repository_id: uuid-text } }
  / "GuildStatus"
  / "GuildCreate"
  / "GuildInvite"
  / { "GuildJoin": { token: tstr } }
  / "GuildRetry"
  / "GuildCancel"
  / "GuildFinalize"
  / { "GuildRemoveMember": { node_id: bytes32-array } }
  / { "GuildRelabelMember": { node_id: bytes32-array, failure_domain: tstr } }
  / { "GuildSetQuorum": { policy: quorum-policy } }
  / "GuildRotateRecoveryKey"
  / { "GuildRevokeRecoveryKey": { subject: bytes32-array, epoch: uint } }
  / { "Backup": { wait: bool, root_id: null / uuid-text } }
  / { "BackupStatus": { revision_id: uuid-text } }
  / { "Recover": { target: tstr } }
  / "SnapshotList"
  / { "SnapshotRestore": { revision_id: null / uuid-text, target: tstr } }

local-response =
    { "Locked": { expected_node_id: bytes32-array } }
  / { "Unlocked": { node_id: bytes32-array } }
  / { "Status": node-status }
  / { "StorageVolumes": [* storage-volume-status] }
  / { "StorageScrubbed": [* storage-scrub-report] }
  / { "StorageReclaimed": { bytes: uint } }
  / { "StorageMigrated": { objects: uint } }
  / "StorageReactivated"
  / "StorageReconciled"
  / { "GuildAudited": guild-audit-report }
  / { "RootAdded": protected-root }
  / { "GitRepositoryInitialized": git-repository-info }
  / { "GitWorktreeRegistered": git-worktree-info }
  / { "GitWorktrees": [* git-worktree-info] }
  / { "GitFileStaged": git-staged-file }
  / { "GitDeletionStaged": { repository_id: uuid-text, path: tstr } }
  / { "GitCachedPathRemoved": { removed: bool } }
  / { "GitIndexReset": { repository_id: uuid-text, changed_paths: uint } }
  / { "GitPendingAddAbandoned": { abandoned: bool } }
  / { "GitCommitted": git-commit-info }
  / { "GitLog": [* git-log-entry] }
  / { "GitBranches": [* git-branch-info] }
  / { "GitObjectsExported": { repository_id: uuid-text, object_count: uint } }
  / { "GitRemoteBranches": [* git-remote-branch-info] }
  / { "GitCommitPins": { repository_id: uuid-text, oids: [* bytes20-array] } }
  / { "GitCommitPinChanged": { repository_id: uuid-text, oid: bytes20-array, pinned: bool } }
  / { "GitPruned": git-prune-report }
  / { "GitBranchCreated": git-branch-info }
  / { "GitBranchDeleted": git-branch-info }
  / { "GitBranchSelected": git-branch-info }
  / { "GitPushed": { repository_id: uuid-text, oid: bytes20-array } }
  / { "GitFetched": { repository_id: uuid-text, branch_count: uint } }
  / { "GitPulled": { repository_id: uuid-text, oid: bytes20-array } }
  / { "GitMerged": { repository_id: uuid-text, oid: bytes20-array } }
  / { "GitMergeAborted": { repository_id: uuid-text } }
  / { "GitDiff": git-diff }
  / { "GitStatus": git-status }
  / { "Guild": null / guild-summary }
  / { "GuildInvite": { token: tstr, expires_at_unix_seconds: uint } }
  / { "GuildEventCommitted": { sequence: uint, event_hash: bytes32-array } }
  / { "BackupJob": backup-job }
  / { "Recovered": dht-recovery-result }
  / { "Snapshots": [* snapshot-info] }
  / { "SnapshotRestored": snapshot-info }

guild-audit-report = {
  format_version: uint,
  checkpoint_hash: bytes32-array,
  checkpoint_generation: uint,
  audited_at_unix_seconds: uint,
  state: "unknown" / "healthy" / "degraded" / "emergency" / "unrecoverable",
  checked_groups: uint,
  assigned_shards_unavailable: uint,
  assigned_shards_repaired: uint,
  emergency_copies_created: uint,
  emergency_copies_removed: uint,
  issues: [* tstr]
}

node-status = {
  format_version: uint,
  node_id: bytes32-array,
  data_dir: tstr,
  protected_roots: [* protected-root],
  checkpoint_count: uint,
  seed_recovery_ready: bool,
  root_dirty: bool,
  automatic_backup: automatic-backup-status,
  protection_state: "unknown" / "healthy" / "degraded" / "emergency" / "unrecoverable",
  last_audit: null / guild-audit-report,
  storage_volumes: [* storage-volume-status],
  network: null / p2p-status
}

automatic-backup-status = {
  enabled: bool,
  dirty_since_unix_seconds: null / uint,
  last_attempt_unix_seconds: null / uint,
  last_success_unix_seconds: null / uint,
  in_flight_revision: null / uuid-text,
  window_backup_count: uint,
  window_bytes: uint,
  retry_at_unix_seconds: null / uint,
  blocked_reason: null / tstr
}

storage-volume-status = {
  volume_id: uuid-text,
  path: tstr,
  state: "online" / "offline" / "draining" / "retired" / "failed",
  budget_bytes: uint,
  headroom_bytes: uint,
  used_bytes: null / uint,
  allocated_bytes: null / uint,
  available_bytes: null / uint,
  object_count: null / uint,
  last_error: null / tstr
}

storage-scrub-report = {
  volume_id: uuid-text,
  checked_objects: uint,
  checked_bytes: uint,
  corrupt_objects: [* [bytes32-array, uint8]]
}

protected-root = {
  format_version: uint,
  root_id: uuid-text,
  path: tstr,
  filesystem_id: uint,
  root_inode: uint
}

git-repository-info = {
  format_version: uint,
  repository_id: uuid-text,
  path: tstr
}

git-worktree-info = {
  format_version: uint,
  repository_id: uuid-text,
  worktree_id: uuid-text,
  path: tstr,
  root_id: { filesystem_id: uint, inode: uint },
  target_branch: tstr,
  state: "Preparing" / "Ready"
}

git-staged-file = {
  format_version: uint,
  repository_id: uuid-text,
  path: tstr,
  oid: tstr,
  mode: uint
}

git-commit-info = {
  format_version: uint,
  repository_id: uuid-text,
  oid: bytes20-array,
  tree_oid: bytes20-array,
  parent_oid: null / bytes20-array,
  branch: tstr
}

git-log-entry = {
  oid: bytes20-array,
  tree_oid: bytes20-array,
  parent_oids: [* bytes20-array],
  author_name: [* uint8],
  author_email: [* uint8],
  message: [* uint8]
}

git-branch-info = {
  format_version: uint,
  repository_id: uuid-text,
  name: tstr,
  oid: bytes20-array,
  current: bool
}

git-remote-branch-info = {
  format_version: uint,
  repository_id: uuid-text,
  name: tstr,
  oid: bytes20-array
}

git-prune-report = {
  format_version: uint,
  repository_id: uuid-text,
  metadata_objects_removed: uint,
  native_anchors_removed: uint,
  logical_anchor_bytes_removed: uint,
  physical_bytes_reclaimed: null / uint
}

git-diff = {
  format_version: uint,
  repository_id: uuid-text,
  cached: bool,
  patch: [* uint8]
}

git-status = {
  format_version: uint,
  repository_id: uuid-text,
  branch: tstr,
  head_oid: null / bytes20-array,
  history_backed_up: bool,
  changes: [* git-status-change],
  untracked: [* [* uint8]],
  pending_adds: [* [* uint8]],
  ? merge: {
    source_ref: [* uint8],
    ours: bytes20-array,
    theirs: bytes20-array,
    unresolved_paths: [* [* uint8]]
  }
}

git-status-change = {
  path: [* uint8],
  staged: null / git-change,
  worktree: null / git-change
}

git-change = "Added" / "Modified" / "Deleted" / "TypeChanged"

p2p-status = {
  peer_id: tstr,
  network_ready: bool,
  direct_listeners_configured: uint,
  direct_listeners_active: uint,
  relay_reservations_configured: uint,
  relay_reservations_active: uint,
  tor_mode: "auto" / "prefer-tor" / "require-tor" / "disable-tor",
  onion_service_configured: bool,
  onion_service_reachable: bool,
  port_mapping_enabled: bool,
  port_mapping_external_address: null / tstr,
  degraded: [* tstr],
  listen_addresses: [* tstr],
  advertised_addresses: [* tstr],
  peers: [* p2p-peer-status],
  active_sessions: [* p2p-active-session],
  recent_sessions: [* p2p-session-history],
  path_metrics: [* p2p-path-metrics]
}

p2p-peer-status = {
  peer_id: tstr,
  active_paths: [* p2p-path],
  last_application_path: null / p2p-path,
  application_bytes_sent: uint,
  application_bytes_received: uint,
  path_transfers: [* p2p-path-transfer]
}

p2p-path-transfer = {
  path: p2p-path,
  application_bytes_sent: uint,
  application_bytes_received: uint
}

p2p-active-session = {
  sequence: uint,
  peer_id: tstr,
  path: p2p-path,
  direction: p2p-session-direction,
  opened_at_unix_seconds: uint
}

p2p-session-history = {
  sequence: uint,
  peer_id: tstr,
  path: p2p-path,
  direction: p2p-session-direction,
  opened_at_unix_seconds: uint,
  closed_at_unix_seconds: uint,
  duration_millis: uint,
  outcome: "closed" / "collapsed" / "transport-error"
}

p2p-path-metrics = {
  path: p2p-path,
  sessions_opened: uint,
  sessions_closed: uint,
  dial_failures: uint,
  requests_succeeded: uint,
  requests_failed: uint,
  request_latency_millis_total: uint,
  application_bytes_sent: uint,
  application_bytes_received: uint
}

p2p-session-direction = "inbound" / "outbound"

p2p-path = "direct" / "relayed" / "hole-punched" / "relay-fallback" / "tor"

guild-summary = {
  format_version: uint,
  guild_id: bytes32-array,
  coordinator: bytes32-array,
  phase: "Draft" / "Joining" / "Active",
  peers: [* guild-peer],
  membership_epoch: null / uint,
  event_sequence: null / uint,
  quorum: null / quorum-policy
}

quorum-policy = {
  format_version: 1,
  rule: "Unanimous" / "Majority" / { "Threshold": uint }
}

guild-peer = { member: member, endpoints: [* tstr] }
member = {
  node_id: bytes32-array,
  recovery_public_key: bytes32-array,
  failure_domain: tstr
}

backup-descriptor = {
  format_version: uint,
  guild_id: bytes32-array,
  owner: bytes32-array,
  protected_root_id: uuid-text,
  revision_id: uuid-text,
  total_pages: uint,
  object_hash: bytes32-array
}

backup-job = {
  format_version: uint,
  descriptor: backup-descriptor,
  state: "Pending" / "Running" / "Committed" / "Failed",
  checkpoint_hash: null / bytes32-array,
  error: null / tstr
}

dht-recovery-result = {
  guild_id: bytes32-array,
  checkpoint_hash: bytes32-array,
  generation: uint,
  revision_id: null / uuid-text
}

snapshot-info = {
  protected_root_id: uuid-text,
  revision_id: uuid-text,
  sequence: uint,
  checkpoint_generation: uint,
  checkpoint_hash: bytes32-array
}

wire-error = {
  code: "invalid_request" / "unauthorized" / "not_found" / "conflict" /
        "busy" / "locked" / "operation_failed",
  retryable: bool,
  message: tstr
}

uuid-text = tstr
uint8 = 0..255
bytes16-array = [16*16 uint8]
bytes32-array = [32*32 uint8]
bytes20-array = [20*20 uint8]
